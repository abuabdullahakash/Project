rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isAuthenticated() && (
        (request.auth.token.email == "fyt0000012@gmail.com" && request.auth.token.email_verified == true) || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().get('role', 'user') in roles)
      );
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Anyone authenticated can read user profiles to see team members
      allow read: if isAuthenticated();
      
      // Users can create their own profile. Role must be 'user' unless admin is creating.
      allow create: if isOwner(userId) && (request.resource.data.role == 'user' || isAdmin());
      
      // Users can update their own profile, but cannot escalate their own role unless they are admin
      allow update: if isAdmin() || (isOwner(userId) && 
        request.resource.data.role == resource.data.role);
        
      allow delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.createdBy == request.auth.uid || 
        (resource.data.managerIds != null && request.auth.uid in resource.data.managerIds)
      );
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.createdBy == request.auth.uid || 
        (resource.data.managerIds != null && request.auth.uid in resource.data.managerIds)
      );
    }

    match /projects/{projectId} {
      // Read: Admins see all. Users see their own, assigned, or if they are in the team.
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        resource.data.assignedTo == request.auth.uid ||
        resource.data.assignedBy == request.auth.uid ||
        (resource.data.teamId != null && exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) && (
          request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('allMembers', []) ||
          request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('managerIds', []) ||
          get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('leaderId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('coLeaderId', '') == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('memberIds', [])
        ))
      );
      
      allow create: if isAuthenticated();
      
      // Update: Admins can update all. Creator can update. Assignee can update. Assigner can update.
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.assignedTo == request.auth.uid ||
        resource.data.assignedBy == request.auth.uid ||
        (resource.data.teamId != null && exists(/databases/$(database)/documents/teams/$(resource.data.teamId)) && (
          request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('allMembers', []) ||
          request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('managerIds', []) ||
          get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('leaderId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('coLeaderId', '') == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.get('memberIds', [])
        ))
      );
      
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
    }
    
    match /globalNotes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /teams/{teamId}/messages/{messageId} {
      function isTeamMember() {
        return exists(/databases/$(database)/documents/teams/$(teamId)) && (
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get('allMembers', []) ||
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get('managerIds', []) ||
          get(/databases/$(database)/documents/teams/$(teamId)).data.get('leaderId', '') == request.auth.uid ||
          get(/databases/$(database)/documents/teams/$(teamId)).data.get('coLeaderId', '') == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.get('memberIds', [])
        );
      }
      
      allow read: if isAuthenticated() && (isAdmin() || isTeamMember());
      allow create: if isAuthenticated() && (isAdmin() || isTeamMember()) && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (isAdmin() || isTeamMember()) && (
        resource.data.senderId == request.auth.uid || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor']) && 
         request.auth.uid in request.resource.data.get('deletedFor', []))
      );
      allow delete: if isAuthenticated() && (isAdmin() || (isTeamMember() && resource.data.senderId == request.auth.uid));
    }
    function isValidTodo(data) {
      return data.keys().hasAll(['userId', 'title', 'completed', 'priority', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             (!('notes' in data) || (data.notes == null || (data.notes is string && data.notes.size() <= 1000))) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('subtasks' in data) || (data.subtasks is list && data.subtasks.size() <= 50)) &&
             (!('order' in data) || (data.order is number)) &&
             (!('isFlagged' in data) || (data.isFlagged is bool)) &&
             (!('reminderMinutes' in data) || (data.reminderMinutes is number)) &&
             (!('reminderSent' in data) || (data.reminderSent is bool)) &&
             (!('estimatedTime' in data) || (data.estimatedTime is number)) &&
             (!('actualTime' in data) || (data.actualTime is number)) &&
             (!('dueDate' in data) || (data.dueDate == null || data.dueDate is string)) &&
             (!('dueTime' in data) || (data.dueTime == null || data.dueTime is string)) &&
             data.completed is bool &&
             data.priority in ['Low', 'Medium', 'High'] &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    match /todos/{todoId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidTodo(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidTodo(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /pushSubscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /portfolios/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    function isValidFixingNote(data) {
      return data.keys().hasAll(['userId', 'title', 'items', 'backgroundColor', 'headerColor', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.items is list && data.items.size() <= 100 &&
             data.backgroundColor is string && data.backgroundColor.size() <= 20 &&
             data.headerColor is string && data.headerColor.size() <= 20 &&
             (!('imageUrl' in data) || (data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000))) &&
             (!('width' in data) || data.width == null || data.width is number) &&
             (!('height' in data) || data.height == null || data.height is number) &&
             (!('positionX' in data) || data.positionX == null || data.positionX is number) &&
             (!('positionY' in data) || data.positionY == null || data.positionY is number) &&
             (!('isPinned' in data) || data.isPinned == null || data.isPinned is bool) &&
             (!('groups' in data) || data.groups is list && data.groups.size() <= 20) &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    match /fixingNotes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidFixingNote(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidFixingNote(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /elementorTemplates/{templateId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /userSecrets/{userId} {
      allow read, write: if isOwner(userId);
    }

    function isValidApiUsage(data) {
      return data.keys().hasAll(['date', 'count', 'tokensUsed', 'lastTokenCost', 'limitTokens', 'updatedAt']) &&
             data.date is string &&
             data.count is number &&
             data.tokensUsed is number &&
             data.lastTokenCost is number &&
             data.limitTokens is number &&
             data.updatedAt is string;
    }

    match /apiUsage/{keyHash} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidApiUsage(request.resource.data);
      allow update: if isAuthenticated() && isValidApiUsage(request.resource.data);
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'year', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.year is string && data.year.size() > 0 && data.year.size() <= 100 &&
             (!('code' in data) || data.code == null || (data.code is string && data.code.size() <= 100)) &&
             (!('credit' in data) || data.credit == null || (data.credit is string && data.credit.size() <= 50)) &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             (!('chapters' in data) || data.chapters == null || (data.chapters is list && data.chapters.size() <= 100)) &&
             (!('additionalLinks' in data) || data.additionalLinks == null || (data.additionalLinks is list && data.additionalLinks.size() <= 50)) &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidCourse(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidCourse(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    function isValidEducationalNote(data) {
      return data.keys().hasAll(['id', 'courseId', 'userId', 'chatTitle', 'categories', 'chapter', 'question', 'gmail', 'aiProvider', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.courseId is string &&
             data.chatTitle is string && data.chatTitle.size() > 0 && data.chatTitle.size() <= 200 &&
             data.categories is list && data.categories.size() <= 10 &&
             data.chapter is string && data.chapter.size() <= 200 &&
             data.question is string && data.question.size() <= 10000 &&
             data.gmail is string && data.gmail.size() <= 200 &&
             data.aiProvider is string && data.aiProvider.size() <= 100 &&
             (!('chatLink' in data) || data.chatLink == null || (data.chatLink is string && data.chatLink.size() <= 1000)) &&
             (!('additionalLinks' in data) || data.additionalLinks == null || (data.additionalLinks is list && data.additionalLinks.size() <= 50)) &&
             (!('questionCount' in data) || data.questionCount == null || data.questionCount is number) &&
             (!('questionImages' in data) || data.questionImages == null || (data.questionImages is list && data.questionImages.size() <= 20)) &&
             (!('questionImageUrl' in data) || data.questionImageUrl == null || (data.questionImageUrl is string && data.questionImageUrl.size() <= 500000)) &&
             (!('solutionImages' in data) || data.solutionImages == null || (data.solutionImages is list && data.solutionImages.size() <= 20)) &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    match /educationalNotes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidEducationalNote(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidEducationalNote(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    function isValidAINote(data) {
      return data.keys().hasAll(['userId', 'chatTitle', 'aiProvider', 'category', 'type', 'gmail', 'notes', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.chatTitle is string && data.chatTitle.size() > 0 && data.chatTitle.size() <= 300 &&
             data.aiProvider is string && data.aiProvider.size() > 0 && data.aiProvider.size() <= 100 &&
             data.category is string && data.category.size() <= 100 &&
             data.type is string && data.type.size() <= 50 &&
             data.gmail is string && data.gmail.size() <= 200 &&
             data.notes is string && data.notes.size() <= 20000 &&
             (!('id' in data) || data.id is string) &&
             (!('aiResponse' in data) || data.aiResponse == null || (data.aiResponse is string && data.aiResponse.size() <= 100000)) &&
             (!('chatLink' in data) || data.chatLink == null || (data.chatLink is string && data.chatLink.size() <= 1500)) &&
             (!('questionCount' in data) || data.questionCount == null || data.questionCount is number) &&
             (!('additionalLinks' in data) || data.additionalLinks == null || (data.additionalLinks is list && data.additionalLinks.size() <= 50)) &&
             (!('isPinned' in data) || data.isPinned == null || data.isPinned is bool) &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    match /aiNotes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidAINote(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidAINote(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    function isValidAICategory(data) {
      return data.keys().hasAll(['userId', 'name', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('id' in data) || data.id is string) &&
             (!('color' in data) || data.color == null || (data.color is string && data.color.size() <= 50)) &&
             data.createdAt is string &&
             data.updatedAt is string;
    }

    match /aiCategories/{categoryId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidAICategory(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidAICategory(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
